<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Pleos Vehicle SDK 권한 (document.pleos.ai › Vehicle SDK › Permission) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />   <!-- 브레이크, 주행 모드 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />  <!-- 방향지시등, 비상등 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />   <!-- 트렁크 열림 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />  <!-- 계기판 경고등(비상등 확인용) -->
    <!-- 속도 (Android 표준 차량 속성) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 비상등 상태 (Android 표준 차량 속성 HAZARD_LIGHTS_STATE) -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <!-- 조향각은 Vehicle SDK SteeringWheel API → CAR_DRIVE 권한으로 충분 -->

    <!-- 음성 인식·위치 (Pleos SDK 준비 중이라 안드로이드 기본 기능으로 대체) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 백그라운드 실행: 다른 앱을 써도 운전 점검·사고 감지 유지 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 사고 감지 시 앱 화면을 앞으로 불러오는 긴급 알림 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="가디언 드라이브"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- 차량 API. 휴대폰 에뮬레이터 테스트도 되도록 필수는 아님 -->
        <uses-library android:name="android.car" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="density|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <!-- 차량(Pleos Connect)은 가로 고정이어야 메인 화면에 뜸. 휴대폰 테스트 때만 코드에서 세로를 허용 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 주행 지켜보기 서비스 (전경 서비스, 상단 알림 표시) -->
        <service
            android:name=".GuardianService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="차량 주행 안전 모니터링 및 사고 감지" />
        </service>
    </application>
</manifest>
